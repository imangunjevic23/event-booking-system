@page "/auth/register"
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Nav

<div class="auth-container">
    <div class="auth-form">
        <h3>Let’s create your account</h3>
        <p>This information is required to book or host.</p>

        <EditForm Model="FormModel" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Legal name</label>
                <InputText @bind-Value="FormModel.FirstName" placeholder="First name" />
                <InputText @bind-Value="FormModel.LastName" placeholder="Last name" />
                <small>Make sure it matches the name on your government ID.</small>
            </div>

            <div class="form-group">
                <label>Email</label>
                <InputText @bind-Value="FormModel.Email" placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label>Date of birth</label>
                <InputDate @bind-Value="FormModel.DateOfBirth" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <InputText type="password" @bind-Value="FormModel.Password" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <button type="submit" class="btn-primary">Agree and continue</button>
        </EditForm>

        <a href="/auth?returnUrl=@Uri.EscapeDataString(ReturnUrl)" class="link-btn">
            Already have an account? Log in
        </a>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    public RegisterFormModel? FormModel { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string ReturnUrl { get; set; } = "/";

    private string? errorMessage;

    protected override void OnInitialized()
    {
        FormModel ??= new RegisterFormModel();
    }

    private async Task RegisterUser()
    {
        errorMessage = null;
        var user = new AppUser
        {
            UserName = FormModel!.Email,
            Email = FormModel.Email,
            DisplayName = $"{FormModel.FirstName} {FormModel.LastName}",
            EmailConfirmed = true
        };

        var createResult = await UserManager.CreateAsync(user, FormModel.Password);
        if (createResult.Succeeded)
        {
            await SignInManager.SignInAsync(user, isPersistent: false);
            HttpContextAccessor.HttpContext.Response.Redirect(ReturnUrl);
        }
        else
        {
            errorMessage = string.Join(", ", createResult.Errors.Select(e => e.Description));
        }
    }


    public class RegisterFormModel
    {
        [Required]
        public string FirstName { get; set; } = "";

        [Required]
        public string LastName { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        public DateTime DateOfBirth { get; set; } = DateTime.Today.AddYears(-18);

        [Required, MinLength(6, ErrorMessage = "Password must be at least 6 characters.")]
        public string Password { get; set; } = "";
    }
}